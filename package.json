{
  "name": "@pipadeep/dsh-pentest",
  "description": "DSH 渗透测试模式（合并版）：记录层（探索链路/资产/漏洞图 + 会话投影 + Web 视图）+ 执行层（4 个薄工具：arsenal/scope/bypass/submit_flag，武器下沉 arsenal 容器）。",
  "version": "1.6.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "test": "node --test test/preset-variants.test.mjs test/lossless-json.test.mjs test/shot-tool.test.mjs",
    "test:boot": "node test/boot-graph.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./bypass-routes": "./lib/bypass-routes.js",
    "./engagements-routes": "./lib/engagements-routes.js",
    "./pentest": "./lib/pentest.js",
    "./pentest-tools": "./lib/pentest-tools.js",
    "./storage-sqlite": "./lib/storage-sqlite.js",
    "./preset-root": "./lib/preset-root.js",
    "./ui-pentest": "./lib/ui-pentest.js",
    "./ui-pentest/package.json": "./package.json",
    "./client": "./lib/ui-pentest.client.js",
    "./invariant": "./lib/invariant.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./preset-skills": "./lib/preset-skills.js"
  },
  "files": [
    "lib/**/*.js",
    "scripts",
    "lib/**/*.py",
    "preset/pentest/**",
    "skills/**",
    "pentest-bypass.example.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
